# 小白桌面宠物网站 —— 环境变量模板
# 说明: 复制本文件为 .env 并按实际情况填入，以 "VITE_" 开头的变量才能被前端代码读取
# ================================================================

# [必填] 后端 Auth / Chat / 资源服务地址 (无尾部斜杠)
VITE_API_BASE=http://127.0.0.1:8787

# [可选] 管理员首次注册邀请码 (部署时替换为随机 32 位字符串)
VITE_ADMIN_INVITE_CODE=CHANGE_ME_TO_32_CHAR_RANDOM_INVITE

# [可选] 百度统计 / 谷歌分析 ID
VITE_ANALYTICS_ID=

# [可选] Sentry DSN (生产错误监控)
VITE_SENTRY_DSN=

# [可选] 外部 CDN 图片资源域名 (用于 CSP 白名单扩展)
VITE_IMG_CDN_ORIGIN=

# [可选] WebSocket 聊天服务器地址 (留空则复用 API_BASE 的 ws://)
VITE_WS_BASE=

# ===== 仅内部构建使用，不会注入到前端 =====
# 构建产物输出目录 (默认 dist)
BUILD_OUT_DIR=dist
