```gitignore
# Dependencies
node_modules/

# Build outputs
dist/
build/
*.js.map
*.tsbuildinfo

# Environment variables
.env
.env.local
*.env.*

# IDE specific
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log

# Coverage reports
coverage/
htmlcov/
.coverage

# Temporary files
*.tmp
*.temp
.DS_Store
Thumbs.db

# Python specific (if applicable)
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so
*.egg-info/
.eggs/

# Node.js specific (if applicable)
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# TypeScript specific (if applicable)
*.tsbuildinfo
.next/
.nuxt/

# Rust specific (if applicable)
target/

# Java specific (if applicable)
*.class
*.jar
*.war
*.ear
*.war
*.ear
*.har
*.hpi
*.jpi
*.sar
*.iml
*.ipr
*.iws
.classpath
.project
.settings/

# C/C++ specific (if applicable)
*.o
*.obj
*.exe
*.dll
*.so
*.a
*.lib
*.dylib
*.plist
*.bin
*.out
*.pid
*.seed
*.prof

# Go specific (if applicable)
*.out
*.exe
*.dll
*.so
*.dylib

# Compressed files
*.zip
*.tar.gz
*.tar.bz2
*.tar.xz
*.gz
*.bz2
*.xz
*.7z
*.rar
*.zst
*.lz4
*.lzh
*.cab
